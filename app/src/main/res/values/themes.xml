<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kalkulasa" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/krem_kasa</item>
        <item name="android:statusBarColor">@color/teal_lumbung</item>
        <item name="android:navigationBarColor">@color/teal_lumbung</item>
    </style>
    <style name="Theme.Kalkulasa.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/teal_lumbung</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="postSplashScreenTheme">@style/Theme.Kalkulasa</item>
    </style>
</resources>
